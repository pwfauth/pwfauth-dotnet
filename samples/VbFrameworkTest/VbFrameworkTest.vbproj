<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <RootNamespace></RootNamespace>
    <StartupObject>VbFrameworkTest.Program</StartupObject>
    <MyType>Empty</MyType>
    <RestoreSources>$(RestoreSources);../../artifacts;https://api.nuget.org/v3/index.json</RestoreSources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PWFAuth" Version="1.0.0-preview.1" />
  </ItemGroup>
</Project>
